# Copy to .env.runtime and pass with `docker run --env-file .env.runtime`.
# Firebase web config and Google Maps keys are public browser configuration, not secrets.
APP_API_BASE_URL=
APP_PREDICT_API_URL=https://predict.example.com/testing/predict
APP_GOOGLE_MAPS_API_KEY=
APP_FIREBASE_API_KEY=replace-with-firebase-web-api-key
APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
APP_FIREBASE_PROJECT_ID=your-project-id
APP_FIREBASE_APP_ID=replace-with-firebase-app-id
APP_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
APP_FIREBASE_MEASUREMENT_ID=
