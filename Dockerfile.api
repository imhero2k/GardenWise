# API server (Express → Postgres / LocalStack RDS / DynamoDB)
#
#   docker build -f Dockerfile.api -t gardenwise-api .
#   docker run --rm -p 3001:3001 \
#     -e DATABASE_URL=postgresql://gardenwise:localpass@host.docker.internal:4510/gardenwise \
#     -e DATABASE_SSL=0 \
#     --add-host=host.docker.internal:host-gateway \
#     gardenwise-api

FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server

ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001
CMD ["node", "server/index.mjs"]
